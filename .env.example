# Copy to .env and fill in. NEVER commit .env
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (local) or Supabase (Project Settings > Database)
DB_NAME=cleanpool
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer   # use "require" for Supabase
